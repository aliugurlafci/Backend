# ---------------------------------------------------------------------------
# Aula CRM backend — environment configuration
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# Runtime mode: development | production | test
NODE_ENV=development

# HTTP server
PORT=4000
# Comma-separated list of allowed CORS origins (the frontend dev URL).
# Use "*" to allow all (development only).
CORS_ORIGINS=http://localhost:3000

# How many reverse proxies sit in front of this process.
#   0            -> none; req.ip is the socket address (correct for a direct listener)
#   1, 2, ...    -> hop count, e.g. 1 behind a single nginx/Traefik
#   10.0.0.0/8   -> a comma-separated list of trusted ingress IPs/CIDRs
# This is a SECURITY setting. X-Forwarded-For is written by the client, so only
# the hops listed here may overwrite the address. Trusting everything ("true")
# makes req.ip caller-controlled, which defeats the login brute-force throttle
# and the edge rate limit — rotate one header and every counter starts fresh.
# Get this wrong the other way (0 while behind a proxy) and every client shares
# the proxy's address; the server logs a warning when it detects that.
AULA_TRUST_PROXY=0

# Requests per minute per client IP, across the whole API. This is a flood
# backstop, not fairness — per-user limits are enforced separately and can
# actually see the user. Keep it generous: an office reaches the server from one
# NAT address, so everyone shares this budget.
AULA_EDGE_RATE_LIMIT=3000

# Minimum log level written: debug | info | warn | error.
# Defaults to debug outside production and info in it. Every API request emits a
# debug line with method, path, user, status and duration, so leaving this at
# debug in production buries the lines that matter. Requests slower than 1s are
# logged at warn regardless of this setting.
AULA_LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database engine selector
# ---------------------------------------------------------------------------
# Which SQL engine the durable backend talks to:
#   mssql -> Microsoft SQL Server (uses the MSSQL_* settings below)
#   mysql -> MySQL 8.0+ / MariaDB 10.2+ (uses the MYSQL_* settings below)
# This is the single switch that decides which database is used. It is ignored
# when AULA_PERSISTENCE=memory (see Persistence below).
DB_CLIENT=mysql

# ---------------------------------------------------------------------------
# MSSQL connection (used when DB_CLIENT=mssql)
# ---------------------------------------------------------------------------
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=aula_crm
MSSQL_USER=sa
MSSQL_PASSWORD=change-me
# Encrypt the connection (true for Azure SQL / TLS-enabled servers).
MSSQL_ENCRYPT=false
# Trust a self-signed server certificate (true for local dev / on-prem).
# Must be false in production — it disables TLS verification.
MSSQL_TRUST_SERVER_CERTIFICATE=true
# Optional named instance (e.g. SQLEXPRESS). Leave blank to use host+port.
MSSQL_INSTANCE=
# Connection pool sizing
MSSQL_POOL_MAX=30
MSSQL_POOL_MIN=2

# ---------------------------------------------------------------------------
# MySQL connection (used when DB_CLIENT=mysql)
# ---------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=aula_crm
MYSQL_USER=root
MYSQL_PASSWORD=change-me
# Connect over TLS (true for managed/cloud MySQL).
MYSQL_SSL=false
# Connection pool sizing
MYSQL_POOL_MAX=30
MYSQL_POOL_MIN=2

# ---------------------------------------------------------------------------
# Auth / secrets
# ---------------------------------------------------------------------------
# HS256 JWT signing secret. REQUIRED in production. Generate a long random value.
AULA_JWT_SECRET=dev-insecure-jwt-secret-change-me
# JWT lifetime in seconds (default 3600 = 1h).
AULA_JWT_TTL=3600
# AES-256-GCM key for field encryption. REQUIRED in production.
AULA_ENCRYPTION_KEY=dev-insecure-key-change-me

# ---------------------------------------------------------------------------
# Tenant identity
# ---------------------------------------------------------------------------
# The scope stamped on every record (tenantId / orgId columns) and carried in
# session tokens. Set these ONCE, before the first run: changing them after data
# exists orphans the existing rows unless you re-scope them (npm run retenant).
# Currency new documents default to, and the one the ledger is kept in.
# TRY | USD | EUR | GBP. The GL does not convert between currencies, so this is
# the currency the books are in — not merely a display preference.
AULA_BASE_CURRENCY=TRY

AULA_TENANT_ID=AULA-CRM
AULA_ORG_ID=Uğur Corp

# ---------------------------------------------------------------------------
# Bootstrap administrator
# ---------------------------------------------------------------------------
# Created on first boot only, when the database has no administrator yet.
# Change the password from Settings -> Security after signing in.
#
# AULA_ADMIN_PASSWORD has NO default: production refuses to start without it.
# Outside production an insecure dev password is used and logged on the boot
# that creates the account. Minimum 8 characters.
AULA_ADMIN_EMAIL=admin@example.com
AULA_ADMIN_PASSWORD=
AULA_ADMIN_NAME=Administrator

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
# "sql" (default, durable — the engine is chosen by DB_CLIENT above) or "memory"
# (process-local, no database — handy for local dev, CI and integration tests;
# all data is lost when the process stops). In "memory" mode the DB_CLIENT /
# MSSQL_* / MYSQL_* settings are ignored.
AULA_PERSISTENCE=sql

# ---------------------------------------------------------------------------
# Bootstrap behaviour
# ---------------------------------------------------------------------------
# Run DDL migrations automatically on server boot (handy in development).
# Must be false in production — run `npm run migrate` as a deploy step instead.
# The administrator account above is provisioned on boot as well (idempotent).
# No sample/demo business data is ever seeded.
AULA_AUTO_MIGRATE=true

# ---------------------------------------------------------------------------
# Email (optional) — SMTP send + IMAP receive for the /email screen.
# Leave unset to run DB-only (compose stores to "sent"; sync is a no-op).
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# true for port 465 (implicit TLS); false for 587 (STARTTLS).
SMTP_SECURE=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_SECURE=true
IMAP_MAILBOX=INBOX

# ---------------------------------------------------------------------------
# File storage — directory for uploaded file bytes (default <cwd>/uploads).
# Point this at a persistent disk or network share in production.
# ---------------------------------------------------------------------------
UPLOAD_DIR=
